# Weaviate Configuration
# If 8080 is in use (e.g. Open WebUI), set e.g. WEAVIATE_URL=http://localhost:8081
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_USE_GRPC=false

# Embedding Configuration
# Provider: "ollama" (local, recommended) or "sentence_transformers" (Hugging Face)
EMBEDDING_PROVIDER=ollama

# Ollama embedding settings (when EMBEDDING_PROVIDER=ollama)
EMBEDDING_OLLAMA_MODEL=bge-m3:latest
EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434

# Sentence-transformers settings (when EMBEDDING_PROVIDER=sentence_transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# Set to true if you get SSL certificate errors downloading from Hugging Face (Docling models, embeddings)
# DISABLE_SSL_VERIFY=true

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Azure OpenAI Configuration (when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=rag-system

# ZenML Configuration
ZENML_STORE_TYPE=local
ZENML_STORE_PATH=.zen

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0
